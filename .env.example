# ============================================================================
# Rally Badminton — biến môi trường. Sao chép thành .env.local rồi điền giá trị.
# Supabase Dashboard > Project Settings > API Keys
# ============================================================================

# URL project, ví dụ https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_...) hoặc anon key (legacy). Được phép lộ ra trình duyệt.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_...) hoặc service_role key (legacy).
# TUYỆT ĐỐI KHÔNG thêm tiền tố NEXT_PUBLIC_, không commit, không gửi cho ai.
SUPABASE_SECRET_KEY=

# Địa chỉ website (dùng cho mã QR chấm công và link tuyệt đối)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Cloudflare Turnstile (chống spam form giữ sân).
# Hai khóa dưới là khóa THỬ NGHIỆM của Cloudflare (luôn hợp lệ) — thay bằng khóa thật khi lên production.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# SePay — xác nhận cọc chuyển khoản tự động (README mục 15).
# Webhook URL khai báo ở SePay: https://<tên miền>/api/webhooks/sepay
# Chọn MỘT cách bảo mật ở SePay và dán khóa tương ứng (không thêm NEXT_PUBLIC_, không commit):
SEPAY_WEBHOOK_SECRET=
SEPAY_WEBHOOK_API_KEY=

# Đối soát dự phòng (README mục 16): SePay > API Access > API Token.
SEPAY_API_TOKEN=

# Email báo chủ sân khi có giao dịch cần xử lý (README mục 16): resend.com > API Keys.
RESEND_API_KEY=
# Người gửi (cần xác minh tên miền ở Resend). Bỏ trống = Rally <onboarding@resend.dev>.
ALERT_EMAIL_FROM=

# Khóa bảo vệ /api/cron/sepay-reconcile (Vercel Cron, Supabase Cron). Chuỗi ngẫu nhiên, không có ký tự $.
CRON_SECRET=
