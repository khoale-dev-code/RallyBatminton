{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rally Manager",
  "version": "1.0.0",
  "identifier": "vn.rally.manager",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:",
      "capabilities": []
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Rally Badminton",
    "shortDescription": "Rally Manager",
    "longDescription": "Ứng dụng quản lý sân Rally Badminton cho máy quầy: lịch đặt sân, thu tiền, bán hàng, in hóa đơn, mở ngăn kéo tiền.",
    "category": "Business",
    "copyright": "Rally Badminton",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Vietnamese"],
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
